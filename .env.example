# TrueSpec environment variables
#
# Copy this file to `.env.local` and fill in the values. This file contains only empty or
# obvious placeholder values — no real keys, tokens or connection strings.
#
# Required: the app cannot start without these.
# Optional: leave blank if the corresponding feature is not used.

# --- Database (required) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Neon (optional; used for the demo branch and preview) ---
NEON_BRANCH=
NEON_API_KEY=
NEON_PROJECT_ID=

# --- Clerk (required) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=

# --- Sanity (required) ---
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_TOKEN=

# --- Session (required) ---
SESSION_SECRET=

# --- Demo (optional) ---
DEMO_DATABASE_URL=
DEMO_BRANCH_ID=
DEMO_RESET_ENABLED=
DEMO_SIGNUP_ENABLED=

# --- Backup (optional) ---
BACKUP_ENCRYPTION_KEY=

# --- Cron (optional) ---
CRON_SECRET=

# --- Error tracking / uptime (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
